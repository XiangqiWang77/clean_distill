# Adopted persistent Clean Self-Distillation proof-of-concept protocol.
#
# This configuration deliberately does not reuse the legacy query-local v6
# meaning of "long horizon".  Long-horizon evidence here is a persistent
# student learning curve over 1,000 DeepMath episodes.

CSD_ACCOUNT=pi_mg269
# The replacement formal run is pinned to one H100 per task.  The H100 queue
# has materially earlier availability than B200/H200; using one accelerator
# type throughout avoids hardware-dependent mixing across query shards.
CSD_GPU_PARTITION=gpu_h100
CSD_GPU_GRES=gpu:h100:1
CSD_GPU_NAME_REGEX=H100
CSD_GPU_CAPABILITY_MAJOR=9
CSD_GPU_CAPABILITY_MINOR=0
CSD_GPU_ARCH_FLAG=sm_90
CSD_PREP_PARTITION=gpu_rtx6000
CSD_PREP_GRES=gpu:rtx_pro_6000_blackwell:1
CSD_CONDA_ENV=TTT
CSD_TTT_PYTHON=/home/da839/.conda/envs/TTT/bin/python
CSD_TORCH_OVERLAY=/home/da839/scratch_pi_mg269/da839/mfspd/pydeps-cu128

CSD_SCRATCH_ROOT=/home/da839/scratch_pi_mg269/da839/clean_distill
CSD_MAX_NEW_DOWNLOAD_BYTES=20000000000
CSD_MAX_TASK_SCRATCH_BYTES=100000000000
CSD_MAX_CONCURRENT_GPUS=4

CSD_MODEL_ID=Qwen/Qwen3-8B
CSD_MODEL_REVISION=b968826d9c46dd6066d109eabc6255188de91218
CSD_MODEL_BYTES=16397461266
CSD_MODEL_LOCAL_DIR=/home/da839/scratch_pi_mg269/da839/clean_distill/models/Qwen3-8B-b968826d9c46dd6066d109eabc6255188de91218

CSD_DEEPMATH_REPO=Leyiii/RLCSD
CSD_DEEPMATH_REVISION=33d7de919af5b03257ff92c30303fddf9afdda4a
CSD_DEEPMATH_RELATIVE_PATH=deepmath_filtered_level7_10/train.parquet
CSD_DEEPMATH_BYTES=587568701
CSD_DEEPMATH_SHA256=611d3030a2a74eaea9514ab732fc33aa6a35d668c7f804c383772939b159f2a0
CSD_DEEPMATH_LOCAL_PATH=/home/da839/scratch_pi_mg269/da839/clean_distill/data/verl/deepmath_filtered_level7_10/train.parquet
CSD_HELDOUT_LOCAL_PATH=/home/da839/scratch_pi_mg269/da839/clean_distill/data/verl/amc23+aime24+aime25/val.parquet
CSD_HELDOUT_REVISION=33d7de919af5b03257ff92c30303fddf9afdda4a
CSD_HELDOUT_BYTES=105032
CSD_HELDOUT_SHA256=42e7c50d0511fb52680ae6fc6cbfc46ff6c361771378dd5c6d228acb61be1cbf

CSD_DISTILL_EPISODES=1000
CSD_DEV_EPISODES=200
CSD_SCIENTIFIC_CHECKPOINTS=0,250,500,750,1000
CSD_ROLLING_CHECKPOINT_INTERVAL=5
CSD_RUN_SEED=0

# RLCSD uses a 16,384-token total training sequence and 38,912-token
# validation generation.  The adopted lower-cost PoC preregisters 32,768
# generated evaluation tokens while preserving Qwen3-8B's 40,960 context.
CSD_TRAIN_MAX_SEQUENCE_TOKENS=16384
CSD_EVAL_MAX_NEW_TOKENS=32768
CSD_CONTEXT_WINDOW_TOKENS=40960
CSD_MAX_PROMPT_TOKENS=8192
CSD_EVAL_SAMPLES=4
CSD_EVAL_TEMPERATURE=0.6
CSD_EVAL_TOP_P=0.95
CSD_EVAL_TOP_K=20

CSD_NUM_CANDIDATES=8
CSD_PROPOSAL_OVERSAMPLE=2
CSD_PROPOSAL_MAX_ROUNDS=3
CSD_MIN_ACCEPTED_CANDIDATES=4
CSD_PROPOSAL_NUM_SHARDS=36
CSD_EVAL_NUM_SHARDS=16

CSD_RIDGE_LAMBDA=0.1
CSD_RESIDUAL_STEP_SIZE=0.8
CSD_MAX_SUPPORT_TOKENS=768
CSD_MAX_TOKENS_PER_CANDIDATE=96
CSD_HARD_NEGATIVES=8
CSD_REASONING_TOKEN_WEIGHT=0.25
CSD_ANSWER_TOKEN_WEIGHT=1.0
CSD_FRONTIER_POSITIVE_WEIGHT=8.0
CSD_FRONTIER_NEGATIVE_WEIGHT=8.0
CSD_FRONTIER_TARGET_MARGIN=1.0
CSD_FRONTIER_MAX_TOKENS=24
CSD_FRONTIER_NEGATIVE_PROBABILITY_FLOOR=0.25
CSD_MAX_UPDATE_NORM=2.0

CSD_LORA_RANK=8
CSD_LORA_ALPHA=16
CSD_LEARNING_RATE=2e-5
CSD_WEIGHT_DECAY=0
CSD_GRADIENT_ACCUMULATION=1
CSD_DISTILL_TOP_K=64
CSD_DISTILL_TEMPERATURE=1.0

# Short allocations + atomic episode checkpoints make preemption recoverable.
CSD_PREP_WALLTIME=01:00:00
CSD_PROPOSAL_WALLTIME=03:00:00
CSD_PERSISTENT_WALLTIME=03:00:00
CSD_EVAL_WALLTIME=03:00:00
CSD_REPORT_WALLTIME=01:00:00
