# Site defaults for the restart-safe multi-B200 proof-of-concept launcher.
#
# This file is sourced by submit_b200_poc.sh.  The four profile knobs can be
# overridden at submission time with NUM_SHARDS, MAX_EVAL_SAMPLES,
# NUM_CANDIDATES, and GPU_WALLTIME.

CSD_ACCOUNT=pi_mg269
CSD_GPU_PARTITION=scavenge_gpu
CSD_CPU_PARTITION=day
CSD_CONDA_ENV=TTT
CSD_MAX_CONCURRENT_SHARDS=2

CSD_SCRATCH_ROOT=/home/da839/scratch_pi_mg269/da839/clean_distill
# Run the real TTT interpreter while placing the existing CUDA 12.8/sm_100
# dependency overlay first on PYTHONPATH. The overlay is reused read-only; it
# is not created or downloaded by this experiment.
CSD_TTT_PYTHON=/home/da839/.conda/envs/TTT/bin/python
CSD_TORCH_OVERLAY=/home/da839/scratch_pi_mg269/da839/mfspd/pydeps-cu128
CSD_MODEL_ID=Qwen/Qwen3-4B
CSD_MODEL_REVISION=1cfa9a7208912126459214e8b04321603b3df60c
CSD_DATASET_NAME=amc23+aime24+aime25
CSD_DATASET_SPLIT=val

# The launcher and prefetch job enforce this strict decimal-byte ceiling only
# across this task's new model and dataset downloads. The pre-existing shared
# CUDA 12.8 overlay above is reused and is not charged to this task's budget.
CSD_MAX_DOWNLOAD_BYTES=9900000000
CSD_EVAL_MAX_NEW_TOKENS=8192
# Long-horizon Task 2 is pre-registered independently of the final 8k decode.
# H_train is the longest *contiguous* same-prefix trajectory, never the sum of
# independent rollouts.  A rollout qualifies when it reaches 4096 tokens or
# terminates naturally before the cap (so its complete trajectory was covered).
CSD_DISTILLATION_STEPS=3
CSD_TRAIN_MAX_NEW_TOKENS=4096
CSD_LONG_HORIZON_MIN_PREFIX_TOKENS=4096
CSD_TARGET_HORIZON_SPLIT_TOKENS=2048
CSD_LATE_WINDOW_START_TOKENS=2048
CSD_MIN_HELDOUT_LATE_QUERIES=10
CSD_PROPOSAL_OVERSAMPLE=2
CSD_PROPOSAL_MAX_ROUNDS=3
CSD_MIN_ACCEPTED_CANDIDATES=4

# Fast infrastructure/protocol check.  Four prefix records spread over two
# B200s keep both array tasks non-empty; this is not a scientific result.
CSD_SMOKE_NUM_SHARDS=2
CSD_SMOKE_MAX_EVAL_SAMPLES=4
CSD_SMOKE_NUM_CANDIDATES=4
CSD_SMOKE_GPU_WALLTIME=04:00:00

# One real pass over all 143 benchmark records. Sixteen restartable shards are
# throttled to at most two concurrent typed B200 tasks.  Three-hour slices keep
# the array backfill-friendly; completed stage markers make preemption/resume
# safe without inflating the formal run to a 48-hour allocation envelope.
CSD_FULL_NUM_SHARDS=16
CSD_FULL_MAX_EVAL_SAMPLES=
CSD_FULL_NUM_CANDIDATES=8
CSD_FULL_GPU_WALLTIME=03:00:00

CSD_PREFETCH_WALLTIME=02:00:00
CSD_REPORT_WALLTIME=01:00:00
